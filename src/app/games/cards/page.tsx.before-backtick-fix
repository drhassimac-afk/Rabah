```tsx
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  ArrowRight,
  Bell,
  Copy,
  Loader2,
  RotateCcw,
  Send,
  Trophy,
  Users,
} from "lucide-react";

type Player = "X" | "O";

type Card = {
  symbol: string;
  name: string;
  value: number;
};

type User = {
  id: number;
  username: string;
  name: string;
};

type Invite = {
  id: number;
  senderId: number;
  receiverId: number;
  game: string;
  roomCode: string;
  status: string;
  createdAt?: string;
};

type Room = {
  id: number;
  code: string;
  playerX: string | null;
  playerO: string | null;
  drawnCardsX: number[];
  drawnCardsO: number[];
  scores: {
    X: number;
    O: number;
  };
  currentPlayer: Player;
  status: string;
  winner: Player | "draw" | null;
};

const cards: Card[] = [
  { symbol: "🂡", name: "آس", value: 11 },
  { symbol: "🂢", name: "اثنان", value: 2 },
  { symbol: "🂣", name: "ثلاثة", value: 3 },
  { symbol: "🂤", name: "أربعة", value: 4 },
  { symbol: "🂥", name: "خمسة", value: 5 },
  { symbol: "🂦", name: "ستة", value: 6 },
  { symbol: "🂧", name: "سبعة", value: 7 },
  { symbol: "🂨", name: "ثمانية", value: 8 },
  { symbol: "🂩", name: "تسعة", value: 9 },
  { symbol: "🂪", name: "عشرة", value: 10 },
];

export default function CardsPage() {
  const router = useRouter();

  const creatingRoom = useRef(false);

  const [user, setUser] = useState<User | null>(null);
  const [room, setRoom] = useState<Room | null>(null);
  const [myPlayer, setMyPlayer] = useState<Player | null>(null);

  const [users, setUsers] = useState<User[]>([]);
  const [invites, setInvites] = useState<Invite[]>([]);

  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [copied, setCopied] = useState(false);

  const loadUsers = useCallback(async () => {
    try {
      const response = await fetch("/api/users", {
        cache: "no-store",
      });

      const data = await response.json();

      if (response.ok && Array.isArray(data.users)) {
        setUsers(data.users);
      }
    } catch {
      // لا نوقف اللعبة إذا فشل تحميل المستخدمين
    }
  }, []);

  const loadInvites = useCallback(async (userId: number) => {
    try {
      const response = await fetch(
        `/api/games/invites?userId=${userId}`,
        {
          cache: "no-store",
        },
      );

      const data = await response.json();

      if (response.ok && Array.isArray(data.invites)) {
        setInvites(
          data.invites.filter(
            (invite: Invite) => invite.game === "cards",
          ),
        );
      }
    } catch {
      // polling صامت
    }
  }, []);

  const loadRoom = useCallback(async (code: string) => {
    try {
      const response = await fetch(
        `/api/games/cards/rooms?code=${encodeURIComponent(code)}`,
        {
          cache: "no-store",
        },
      );

      const data = await response.json();

      if (response.ok && data.success) {
        setRoom(data.room);
      }
    } catch {
      // polling صامت
    }
  }, []);

  const createRoom = useCallback(async (currentUser: User) => {
    if (creatingRoom.current) return;

    creatingRoom.current = true;

    try {
      setLoading(true);
      setError("");

      const response = await fetch("/api/games/cards/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "create",
          player: currentUser.name || currentUser.username,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.error || "تعذر إنشاء غرفة اللعبة",
        );
      }

      setRoom(data.room);
      setMyPlayer(data.player);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "تعذر إنشاء غرفة اللعبة",
      );
    } finally {
      setLoading(false);
    }
  }, []);

  /*
   * تحميل المستخدم الحالي وإنشاء غرفة واحدة فقط.
   */
  useEffect(() => {
    const storedUser = localStorage.getItem("rabahdj_user");

    if (!storedUser) {
      router.push("/join");
      return;
    }

    try {
      const parsedUser = JSON.parse(storedUser) as User;

      if (!parsedUser?.id) {
        router.push("/join");
        return;
      }

      setUser(parsedUser);

      loadUsers();
      loadInvites(parsedUser.id);
      createRoom(parsedUser);
    } catch {
      router.push("/join");
    }
  }, [
    createRoom,
    loadInvites,
    loadUsers,
    router,
  ]);

  /*
   * تحديث الدعوات واللاعبين والغرفة.
   */
  useEffect(() => {
    if (!user) return;

    const interval = setInterval(() => {
      loadInvites(user.id);
      loadUsers();

      if (room?.code) {
        loadRoom(room.code);
      }
    }, 2000);

    return () => clearInterval(interval);
  }, [
    loadInvites,
    loadRoom,
    loadUsers,
    room?.code,
    user,
  ]);

  const sendInvite = async (receiverId: number) => {
    if (!user || !room) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/games/invites", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "create",
          senderId: user.id,
          receiverId,
          game: "cards",
          roomCode: room.code,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.error || "تعذر إرسال الدعوة",
        );
      }

      setMessage("تم إرسال الدعوة بنجاح 🎮");
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "تعذر إرسال الدعوة",
      );
    } finally {
      setBusy(false);
    }
  };

  const handleInvite = async (
    invite: Invite,
    action: "accept" | "reject",
  ) => {
    if (!user) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/games/invites", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action,
          inviteId: invite.id,
          receiverId: user.id,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.error || "تعذر معالجة الدعوة",
        );
      }

      setInvites((previous) =>
        previous.filter(
          (item) => item.id !== invite.id,
        ),
      );

      if (action === "accept") {
        const joinResponse = await fetch(
          "/api/games/cards/rooms",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              action: "join",
              code: invite.roomCode,
              player:
                user.name || user.username,
            }),
          },
        );

        const joinData = await joinResponse.json();

        if (!joinResponse.ok || !joinData.success) {
          throw new Error(
            joinData.error ||
              "تعذر الدخول إلى الغرفة",
          );
        }

        setRoom(joinData.room);
        setMyPlayer(joinData.player);
        setMessage(
          "تم قبول الدعوة. بدأت اللعبة 🎉",
        );
      } else {
        setMessage("تم رفض الدعوة");
      }
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "تعذر معالجة الدعوة",
      );
    } finally {
      setBusy(false);
    }
  };

  const drawCard = async () => {
    if (
      !room ||
      !myPlayer ||
      room.status !== "playing" ||
      room.currentPlayer !== myPlayer
    ) {
      return;
    }

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch(
        "/api/games/cards/rooms",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            action: "draw",
            code: room.code,
            player: myPlayer,
          }),
        },
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.error || "تعذر سحب البطاقة",
        );
      }

      setRoom(data.room);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "تعذر سحب البطاقة",
      );
    } finally {
      setBusy(false);
    }
  };

  const resetGame = async () => {
    if (!room) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch(
        "/api/games/cards/rooms",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            action: "reset",
            code: room.code,
          }),
        },
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data.error || "تعذر إعادة اللعبة",
        );
      }

      setRoom(data.room);

      /*
       * الـAPI يعيد الدور إلى X.
       * لذلك اللاعب X يبقى X واللاعب O يبقى O.
       */
      setMessage("بدأت جولة جديدة 🎮");
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "تعذر إعادة اللعبة",
      );
    } finally {
      setBusy(false);
    }
  };

  const copyCode = async () => {
    if (!room) return;

    try {
      await navigator.clipboard.writeText(room.code);

      setCopied(true);

      setTimeout(() => {
        setCopied(false);
      }, 1500);
    } catch {
      setMessage(`رمز الغرفة: ${room.code}`);
    }
  };

  if (loading || !user || !room || !myPlayer) {
    return (
      <main
        className="min-h-screen bg-slate-950 text-white flex items-center justify-center p-6"
        dir="rtl"
      >
        <div className="text-center">
          <Loader2 className="w-10 h-10 animate-spin mx-auto mb-4" />

          <p className="text-slate-400">
            جارٍ تجهيز لعبة الورق...
          </p>

          {error && (
            <p className="text-red-400 mt-4">
              {error}
            </p>
          )}
        </div>
      </main>
    );
  }

  const currentDrawnCards =
    myPlayer === "X"
      ? room.drawnCardsX
      : room.drawnCardsO;

  const currentCardIndex =
    currentDrawnCards[
      currentDrawnCards.length - 1
    ];

  const currentCard =
    currentCardIndex !== undefined
      ? cards[currentCardIndex]
      : null;

  const totalDrawn =
    room.drawnCardsX.length +
    room.drawnCardsO.length;

  const isMyTurn =
    room.status === "playing" &&
    room.currentPlayer === myPlayer;

  const otherPlayer =
    myPlayer === "X"
      ? room.playerO
      : room.playerX;

  const winnerName =
    room.winner === "draw"
      ? "تعادل"
      : room.winner === "X"
        ? room.playerX
        : room.playerO;

  return (
    <main
      className="min-h-screen bg-slate-950 text-white p-4"
      dir="rtl"
    >
      <div className="max-w-md mx-auto pb-8">

        {/* Header */}
        <header className="flex items-center justify-between mb-5">
          <button
            onClick={() => router.push("/games")}
            className="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center"
          >
            <ArrowRight className="w-5 h-5" />
          </button>

          <div className="text-center">
            <h1 className="text-2xl font-black">
              🃏 لعبة الورق
            </h1>

            <p className="text-xs text-slate-400 mt-1">
              اسحب البطاقات واجمع أكبر مجموع
            </p>
          </div>

          <button
            onClick={copyCode}
            className="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center"
            title="نسخ رمز الغرفة"
          >
            <Copy className="w-5 h-5" />
          </button>
        </header>

        {/* Room code */}
        <button
          onClick={copyCode}
          className="w-full rounded-2xl border border-purple-500/30 bg-purple-500/10 p-4 mb-4 text-center"
        >
          <div className="text-xs text-slate-400 mb-1">
            رمز الغرفة
          </div>

          <div className="text-2xl font-black tracking-[0.3em]">
            {room.code}
          </div>

          <div className="text-xs text-purple-300 mt-1">
            {copied
              ? "تم نسخ الرمز ✓"
              : "اضغط لنسخ الرمز"}
          </div>
        </button>

        {/* Notifications */}
        {error && (
          <div className="rounded-2xl bg-red-500/10 border border-red-500/30 text-red-300 p-3 mb-4 text-center">
            {error}
          </div>
        )}

        {message && (
          <div className="rounded-2xl bg-green-500/10 border border-green-500/30 text-green-300 p-3 mb-4 text-center">
            {message}
          </div>
        )}

        {/* Invites */}
        {invites.length > 0 && (
          <section className="rounded-2xl bg-slate-900 border border-purple-500/30 p-4 mb-4">
            <div className="flex items-center gap-2 mb-3">
              <Bell className="w-5 h-5 text-purple-400" />

              <h2 className="font-bold">
                دعوات لعب الورق
              </h2>

              <span className="mr-auto rounded-full bg-purple-600 px-2 py-1 text-xs font-bold">
                {invites.length}
              </span>
            </div>

            <div className="space-y-3">
              {invites.map((invite) => {
                const sender = users.find(
                  (item) =>
                    item.id === invite.senderId,
                );

                return (
                  <div
                    key={invite.id}
                    className="rounded-xl bg-slate-800 p-3"
                  >
                    <div className="mb-3">
                      <div className="font-bold">
                        🎮{" "}
                        {sender?.name ||
                          "لاعب"}
                      </div>

                      <div className="text-xs text-slate-400 mt-1">
                        دعاك للعب الورق
                      </div>
                    </div>

                    <div className="flex gap-2">
                      <button
                        onClick={() =>
                          handleInvite(
                            invite,
                            "accept",
                          )
                        }
                        disabled={busy}
                        className="flex-1 py-2 rounded-xl bg-green-600 hover:bg-green-500 disabled:opacity-50 font-bold"
                      >
                        قبول
                      </button>

                      <button
                        onClick={() =>
                          handleInvite(
                            invite,
                            "reject",
                          )
                        }
                        disabled={busy}
                        className="flex-1 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 disabled:opacity-50 font-bold"
                      >
                        رفض
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        {/* Players */}
        <section className="grid grid-cols-2 gap-3 mb-4">

          <div
            className={`rounded-2xl p-4 text-center border ${
              myPlayer === "X"
                ? "border-purple-500 bg-purple-500/10"
                : "border-slate-800 bg-slate-900"
            }`}
          >
            <div className="text-sm text-slate-400">
              اللاعب X
            </div>

            <div className="font-bold truncate mt-1">
              {room.playerX || "انتظر..."}
            </div>

            <div className="text-3xl font-black mt-2">
              {room.scores.X}
            </div>
          </div>

          <div
            className={`rounded-2xl p-4 text-center border ${
              myPlayer === "O"
                ? "border-purple-500 bg-purple-500/10"
                : "border-slate-800 bg-slate-900"
            }`}
          >
            <div className="text-sm text-slate-400">
              اللاعب O
            </div>

            <div className="font-bold truncate mt-1">
              {room.playerO || "انتظر..."}
            </div>

            <div className="text-3xl font-black mt-2">
              {room.scores.O}
            </div>
          </div>
        </section>

        {/* Waiting */}
        {room.status === "waiting" && (
          <section className="rounded-2xl bg-slate-900 border border-slate-800 p-5 mb-4 text-center">

            <Users className="w-10 h-10 mx-auto text-purple-400 mb-3" />

            <h2 className="text-lg font-bold">
              انتظر اللاعب الثاني
            </h2>

            <p className="text-sm text-slate-400 mt-2">
              أرسل دعوة للاعب لبدء المباراة
            </p>

            <div className="mt-5 space-y-2">
              {users
                .filter(
                  (item) => item.id !== user.id,
                )
                .map((item) => (
                  <div
                    key={item.id}
                    className="flex items-center justify-between bg-slate-800 rounded-xl p-3"
                  >
                    <div className="text-right">
                      <div className="font-bold">
                        {item.name}
                      </div>

                      <div className="text-xs text-slate-500">
                        @{item.username}
                      </div>
                    </div>

                    <button
                      onClick={() =>
                        sendInvite(item.id)
                      }
                      disabled={busy}
                      className="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 disabled:opacity-50 flex items-center gap-2 text-sm font-bold"
                    >
                      <Send className="w-4 h-4" />
                      دعوة
                    </button>
                  </div>
                ))}
            </div>
          </section>
        )}

        {/* Turn */}
        {room.status === "playing" && (
          <section
            className={`rounded-2xl p-4 mb-4 text-center border ${
              isMyTurn
                ? "bg-purple-500/15 border-purple-500/40"
                : "bg-slate-900 border-slate-800"
            }`}
          >
            <div className="text-lg font-black">
              {isMyTurn
                ? "🎯 دورك الآن"
                : `⏳ دور ${
                    room.currentPlayer === "X"
                      ? room.playerX
                      : room.playerO
                  }`}
            </div>

            <div className="text-xs text-slate-400 mt-1">
              {otherPlayer
                ? `ضد ${otherPlayer}`
                : ""}
            </div>
          </section>
        )}

        {/* Finished */}
        {room.status === "finished" && (
          <section className="rounded-2xl bg-slate-900 border border-yellow-500/30 p-5 mb-4 text-center">

            <Trophy className="w-12 h-12 mx-auto text-yellow-400 mb-3" />

            <h2 className="text-2xl font-black">
              {room.winner === "draw"
                ? "تعادل!"
                : room.winner === myPlayer
                  ? "🎉 فزت!"
                  : "انتهت اللعبة"}
            </h2>

            {room.winner !== "draw" && (
              <p className="text-slate-400 mt-2">
                الفائز:{" "}
                <span className="text-white font-bold">
                  {winnerName}
                </span>
              </p>
            )}

            <button
              onClick={resetGame}
              disabled={busy}
              className="w-full mt-5 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 disabled:opacity-50 font-bold flex items-center justify-center gap-2"
            >
              <RotateCcw className="w-5 h-5" />
              إعادة اللعبة
            </button>
          </section>
        )}

        {/* Card */}
        <section className="rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 p-6 text-center">

          <div className="text-sm text-slate-400 mb-3">
            بطاقتك الأخيرة
          </div>

          {currentCard ? (
            <div className="rounded-3xl bg-white text-slate-950 p-6 shadow-2xl">

              <div className="text-7xl leading-none">
                {currentCard.symbol}
              </div>

              <div className="text-xl font-black mt-4">
                {currentCard.name}
              </div>

              <div className="text-slate-500 mt-2">
                قيمة البطاقة
              </div>

              <div className="text-4xl font-black mt-1">
                {currentCard.value}
              </div>
            </div>
          ) : (
            <div className="rounded-3xl bg-slate-800/60 p-10">
              <div className="text-7xl mb-4">
                🃏
              </div>

              <p className="text-slate-400">
                اسحب بطاقة عندما يحين دورك
              </p>
            </div>
          )}

          <button
            onClick={drawCard}
            disabled={
              busy ||
              room.status !== "playing" ||
              !isMyTurn ||
              totalDrawn >= cards.length
            }
            className="w-full py-4 rounded-2xl bg-red-600 hover:bg-red-500 disabled:opacity-50 disabled:cursor-not-allowed font-black text-lg mt-5"
          >
            {busy
              ? "⏳ جارٍ السحب..."
              : isMyTurn
                ? "🃏 سحب بطاقة"
                : "⏳ انتظر دورك"}
          </button>
        </section>

        {/* Progress */}
        <section className="rounded-2xl bg-slate-900 border border-slate-800 p-4 mt-4">

          <div className="flex justify-between text-sm mb-3">
            <span>
              بطاقات X:{" "}
              <strong>
                {room.drawnCardsX.length}
              </strong>{" "}
              / 10
            </span>

            <span>
              بطاقات O:{" "}
              <strong>
                {room.drawnCardsO.length}
              </strong>{" "}
              / 10
            </span>
          </div>

          <div className="h-3 rounded-full bg-slate-800 overflow-hidden">
            <div
              className="h-full bg-purple-600 transition-all duration-500"
              style={{
                width: `${
                  (totalDrawn / cards.length) *
                  100
                }%`,
              }}
            />
          </div>

          <div className="text-center text-xs text-slate-500 mt-2">
            تم سحب {totalDrawn} من {cards.length} بطاقات
          </div>
        </section>

        {/* My player */}
        <div className="text-center text-sm text-slate-500 mt-5">
          أنت اللاعب{" "}
          <span className="font-bold text-purple-400">
            {myPlayer}
          </span>
        </div>

      </div>
    </main>
  );
}
```

