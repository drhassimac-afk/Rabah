"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  ArrowRight,
  Bell,
  Copy,
  Loader2,
  LogIn,
  RotateCcw,
  Send,
  Trophy,
  Users,
} from "lucide-react";

type Player = "X" | "O";

type Card = {
  symbol: string;
  name: string;
  value: number;
};

type User = {
  id: number;
  username: string;
  name: string;
};

type Invite = {
  id: number;
  senderId: number;
  receiverId: number;
  game: string;
  roomCode: string;
  status: string;
  createdAt?: string;
};

type Room = {
  id: number;
  code: string;
  playerX: string | null;
  playerO: string | null;
  drawnCardsX: number[];
  drawnCardsO: number[];
  scores: {
    X: number;
    O: number;
  };
  currentPlayer: Player;
  status: string;
  winner: Player | "draw" | null;
};

const cards: Card[] = [
  { symbol: "🂡", name: "آس", value: 11 },
  { symbol: "🂢", name: "اثنان", value: 2 },
  { symbol: "🂣", name: "ثلاثة", value: 3 },
  { symbol: "🂤", name: "أربعة", value: 4 },
  { symbol: "🂥", name: "خمسة", value: 5 },
  { symbol: "🂦", name: "ستة", value: 6 },
  { symbol: "🂧", name: "سبعة", value: 7 },
  { symbol: "🂨", name: "ثمانية", value: 8 },
  { symbol: "🂩", name: "تسعة", value: 9 },
  { symbol: "🂪", name: "عشرة", value: 10 },
];

export default function CardsPage() {
  const router = useRouter();

  const creatingRoom = useRef(false);

  const [user, setUser] = useState<User | null>(null);
  const [room, setRoom] = useState<Room | null>(null);
  const [myPlayer, setMyPlayer] = useState<Player | null>(null);

  const [users, setUsers] = useState<User[]>([]);
  const [invites, setInvites] = useState<Invite[]>([]);

  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [copied, setCopied] = useState(false);

  const loadUsers = useCallback(async () => {
    try {
      const response = await fetch("/api/users", {
        cache: "no-store",
      });

      const data = await response.json();

      if (response.ok && Array.isArray(data.users)) {
        setUsers(data.users);
      }
    } catch {
      // لا نوقف اللعبة إذا فشل تحميل قائمة اللاعبين
    }
  }, []);

  const loadInvites = useCallback(async (userId: number) => {
    try {
      const response = await fetch(`/api/games/invites?userId=${userId}`, {
        cache: "no-store",
      });

      const data = await response.json();

      if (response.ok && Array.isArray(data.invites)) {
        setInvites(
          data.invites.filter((invite: Invite) => invite.game === "cards"),
        );
      }
    } catch {
      // polling صامت
    }
  }, []);

  const loadRoom = useCallback(async (code: string) => {
    try {
      const response = await fetch(
        `/api/games/cards/rooms?code=${encodeURIComponent(code)}`,
        {
          cache: "no-store",
        },
      );

      const data = await response.json();

      if (response.ok && data.success) {
        setRoom(data.room);
      }
    } catch {
      // polling صامت
    }
  }, []);

  const createRoom = useCallback(async (currentUser: User) => {
    if (creatingRoom.current) return;

    creatingRoom.current = true;

    try {
      setLoading(true);
      setError("");

      const response = await fetch("/api/games/cards/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "create",
          player: currentUser.name || currentUser.username,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "تعذر إنشاء غرفة اللعبة");
      }

      setRoom(data.room);
      setMyPlayer(data.player);
    } catch (err) {
      setError(err instanceof Error ? err.message : "تعذر إنشاء غرفة اللعبة");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    const storedUser = localStorage.getItem("rabahdj_user");

    if (!storedUser) {
      router.push("/join");
      return;
    }

    try {
      const parsedUser = JSON.parse(storedUser) as User;

      if (!parsedUser?.id) {
        router.push("/join");
        return;
      }

      setUser(parsedUser);
      loadUsers();
      loadInvites(parsedUser.id);
      createRoom(parsedUser);
    } catch {
      router.push("/join");
    }
  }, [createRoom, loadInvites, loadUsers, router]);

  useEffect(() => {
    if (!user) return;

    const interval = setInterval(() => {
      loadInvites(user.id);
      loadUsers();

      if (room?.code) {
        loadRoom(room.code);
      }
    }, 3000);

    return () => clearInterval(interval);
  }, [loadInvites, loadRoom, loadUsers, room?.code, user]);

  const sendInvite = async (receiverId: number) => {
    if (!user || !room) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/games/invites", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "create",
          senderId: user.id,
          receiverId,
          game: "cards",
          roomCode: room.code,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "تعذر إرسال الدعوة");
      }

      setMessage("تم إرسال الدعوة بنجاح 🎮");
    } catch (err) {
      setError(err instanceof Error ? err.message : "تعذر إرسال الدعوة");
    } finally {
      setBusy(false);
    }
  };

  const handleInvite = async (invite: Invite, action: "accept" | "reject") => {
    if (!user) return;

    setBusy(true);
    setError("");

    try {
      const response = await fetch("/api/games/invites", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action,
          inviteId: invite.id,
          receiverId: user.id,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "تعذر معالجة الدعوة");
      }

      setInvites((previous) =>
        previous.filter((item) => item.id !== invite.id),
      );

      if (action === "accept") {
        const joinResponse = await fetch("/api/games/cards/rooms", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            action: "join",
            code: invite.roomCode,
            player: user.name || user.username,
          }),
        });

        const joinData = await joinResponse.json();

        if (!joinResponse.ok || !joinData.success) {
          throw new Error(joinData.error || "تعذر الدخول إلى الغرفة");
        }

        setRoom(joinData.room);
        setMyPlayer(joinData.player);
        setMessage("تم قبول الدعوة. بدأت اللعبة 🎉");
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : "تعذر معالجة الدعوة");
    } finally {
      setBusy(false);
    }
  };

  const drawCard = async () => {
    if (!room || !myPlayer || room.currentPlayer !== myPlayer) {
      return;
    }

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/games/cards/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "draw",
          code: room.code,
          player: myPlayer,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "تعذر سحب البطاقة");
      }

      setRoom(data.room);
    } catch (err) {
      setError(err instanceof Error ? err.message : "تعذر سحب البطاقة");
    } finally {
      setBusy(false);
    }
  };

  const resetGame = async () => {
    if (!room) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/games/cards/rooms", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action: "reset",
          code: room.code,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "تعذر إعادة اللعبة");
      }

      setRoom(data.room);
      setMyPlayer("X");
    } catch (err) {
      setError(err instanceof Error ? err.message : "تعذر إعادة اللعبة");
    } finally {
      setBusy(false);
    }
  };

  const copyCode = async () => {
    if (!room) return;

    try {
      await navigator.clipboard.writeText(room.code);
      setCopied(true);

      setTimeout(() => setCopied(false), 1500);
    } catch {
      setMessage(`رمز الغرفة: ${room.code}`);
    }
  };

  if (loading || !user || !room || !myPlayer) {
    return (
      <main
        className="min-h-screen bg-slate-950 text-white flex items-center justify-center p-6"
        dir="rtl"
      >
        <div className="text-center">
          <Loader2 className="w-10 h-10 animate-spin mx-auto mb-4" />
          <p className="text-slate-400">جارٍ تجهيز لعبة الورق...</p>
        </div>
      </main>
    );
  }

  const currentDrawnCards =
    myPlayer === "X" ? room.drawnCardsX : room.drawnCardsO;

  const currentCardIndex = currentDrawnCards[currentDrawnCards.length - 1];

  const currentCard =
    currentCardIndex !== undefined ? cards[currentCardIndex] : null;

  return (
    <main className="min-h-screen bg-slate-950 text-white p-4" dir="rtl">
      <div className="max-w-md mx-auto">
        <header className="flex items-center justify-between mb-6">
          <button
            onClick={() => router.push("/games")}
            className="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center"
          >
            <ArrowRight className="w-5 h-5" />
          </button>

          <div className="text-center">
            <h1 className="text-2xl font-bold">🃏 لعبة الورق</h1>

            <button
              onClick={copyCode}
              className="mt-1 text-xs text-slate-400 flex items-center gap-1 mx-auto"
            >
              <Copy className="w-3 h-3" />
              {copied ? "تم النسخ" : `الغرفة ${room.code}`}
            </button>
          </div>

          <div className="relative">
            <Bell className="w-6 h-6" />
            {invites.length > 0 && (
              <span className="absolute -top-2 -left-2 min-w-5 h-5 px-1 rounded-full bg-red-500 text-xs flex items-center justify-center">
                {invites.length}
              </span>
            )}
          </div>
        </header>

        {invites.length > 0 && (
          <div className="glass rounded-2xl p-4 mb-4 border border-yellow-500/30">
            <div className="flex items-center gap-2 mb-3">
              <Bell className="w-5 h-5 text-yellow-400" />
              <h2 className="font-bold">دعوات لعب الورق</h2>
            </div>

            <div className="space-y-3">
              {invites.map((invite) => {
                const sender = users.find(
                  (item) => item.id === invite.senderId,
                );

                return (
                  <div key={invite.id} className="bg-slate-900 rounded-xl p-3">
                    <p className="mb-3">
                      🎮{" "}
                      <span className="font-bold">
                        {sender?.name || "لاعب"}
                      </span>{" "}
                      دعاك للعب الورق
                    </p>

                    <div className="flex gap-2">
                      <button
                        onClick={() => handleInvite(invite, "accept")}
                        disabled={busy}
                        className="flex-1 py-2 rounded-xl bg-green-600 hover:bg-green-500 disabled:opacity-50 font-bold"
                      >
                        قبول
                      </button>

                      <button
                        onClick={() => handleInvite(invite, "reject")}
                        disabled={busy}
                        className="flex-1 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 disabled:opacity-50"
                      >
                        رفض
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {error && (
          <div className="bg-red-500/10 border border-red-500/30 text-red-300 rounded-xl p-3 mb-4 text-center text-sm">
            {error}
          </div>
        )}

        {message && (
          <div className="bg-green-500/10 border border-green-500/30 text-green-300 rounded-xl p-3 mb-4 text-center text-sm">
            {message}
          </div>
        )}

        <div className="grid grid-cols-2 gap-3 mb-4">
          <div
            className={`rounded-2xl p-4 text-center border ${
              myPlayer === "X"
                ? "border-purple-500 bg-purple-500/10"
                : "border-slate-800 bg-slate-900"
            }`}
          >
            <div className="text-sm text-slate-400">
              X — {room.playerX || "انتظر..."}
            </div>

            <div className="text-3xl font-bold">{room.scores.X}</div>
          </div>

          <div
            className={`rounded-2xl p-4 text-center border ${
              myPlayer === "O"
                ? "border-purple-500 bg-purple-500/10"
                : "border-slate-800 bg-slate-900"
            }`}
          >
            <div className="text-sm text-slate-400">
              O — {room.playerO || "انتظر..."}
            </div>

            <div className="text-3xl font-bold">{room.scores.O}</div>
          </div>
        </div>

        {room.status === "waiting" && (
          <div className="rounded-2xl bg-yellow-500/10 border border-yellow-500/30 p-4 mb-4">
            <div className="flex items-center gap-2 justify-center mb-3">
              <Users className="w-5 h-5" />
              <span>انتظر اللاعب الثاني...</span>
            </div>

            <p className="text-center text-sm text-slate-400 mb-4">
              يمكنك دعوة لاعب مباشرة من القائمة
            </p>

            <div className="space-y-2">
              {users
                .filter((item) => item.id !== user.id)
                .map((item) => (
                  <div
                    key={item.id}
                    className="flex items-center justify-between bg-slate-900 rounded-xl p-3"
                  >
                    <span>{item.name}</span>

                    <button
                      onClick={() => sendInvite(item.id)}
                      disabled={busy}
                      className="px-3 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 disabled:opacity-50 flex items-center gap-2 text-sm font-bold"
                    >
                      <Send className="w-4 h-4" />
                      دعوة
                    </button>
                  </div>
                ))}
            </div>
          </div>
        )}

        {room.status === "playing" && (
          <div
            className={`rounded-2xl p-3 text-center mb-4 ${
              room.currentPlayer === myPlayer
                ? "bg-purple-500/15 border border-purple-500/30"
                : "bg-slate-900 border border-slate-800"
            }`}
          >
            {room.currentPlayer === myPlayer
              ? "🎯 دورك الآن"
              : `⏳ دور ${room.currentPlayer === "X" ? room.playerX : room.playerO}`}
          </div>
        )}

        {room.status === "finished" && (
          <div className="rounded-2xl bg-purple-500/10 border border-purple-500/30 p-5 text-center mb-4">
            <Trophy className="w-10 h-10 mx-auto mb-2" />

            <div className="text-xl font-bold">
              {room.winner === "draw"
                ? "تعادل!"
                : room.winner === myPlayer
                  ? "🎉 فزت!"
                  : "انتهت اللعبة"}
            </div>

            <button
              onClick={resetGame}
              disabled={busy}
              className="mt-4 px-5 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 disabled:opacity-50 flex items-center gap-2 mx-auto"
            >
              <RotateCcw className="w-4 h-4" />
              إعادة اللعبة
            </button>
          </div>
        )}

        <div className="glass rounded-3xl p-6 text-center">
          <div className="min-h-[260px] flex items-center justify-center">
            {currentCard ? (
              <div className="bg-white text-slate-900 rounded-3xl w-44 h-64 flex flex-col items-center justify-center shadow-2xl">
                <div className="text-7xl mb-4">{currentCard.symbol}</div>

                <div className="text-2xl font-bold">{currentCard.name}</div>

                <div className="text-slate-500 mt-2">
                  قيمة البطاقة: {currentCard.value}
                </div>
              </div>
            ) : (
              <div>
                <div className="text-7xl mb-4">🃏</div>
                <p className="text-slate-400">اسحب بطاقة عندما يحين دورك</p>
              </div>
            )}
          </div>

          <button
            onClick={drawCard}
            disabled={
              busy ||
              room.status !== "playing" ||
              room.currentPlayer !== myPlayer ||
              room.drawnCardsX.length + room.drawnCardsO.length >= cards.length
            }
            className="w-full py-4 rounded-2xl bg-red-600 hover:bg-red-500 disabled:opacity-50 disabled:cursor-not-allowed font-bold mt-4"
          >
            {room.currentPlayer === myPlayer ? "🃏 سحب بطاقة" : "⏳ انتظر دورك"}
          </button>
        </div>

        <div className="mt-5 text-center text-sm text-slate-500">
          بطاقات X: {room.drawnCardsX.length} / 10
          {" • "}
          بطاقات O: {room.drawnCardsO.length} / 10
        </div>

        <div className="mt-2 text-center text-sm text-slate-500">
          أنت اللاعب {myPlayer}
        </div>
      </div>
    </main>
  );
}
